pipeline {
    agent { label 'built-in' }

    stages {
        stage('Checkout from GitHub') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Somnathg3/wslubuntu.git'
            }
        }

        stage('Deploy to Apache') {
            steps {
                sh 'sudo -n /usr/local/bin/deploy-apache-index'
            }
        }
    }
}
